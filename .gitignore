__pycache__/
*.py[cod]
.pytest_cache/
.venv/
dist/
build/
*.egg-info/
.env
.env.*
!.env.example
.vscode/
.idea/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
*.log

# 原始图像和运行结果通常体积较大，仅保留目录骨架。
data/raw/*/*
!data/raw/*/.gitkeep
outputs/**
!outputs/.gitkeep

# Pretest acquisition data and generated reports stay local.
laser_pretest_dataset/metadata.csv
laser_pretest_dataset/metadata.xlsx
laser_pretest_dataset/raw/**
laser_pretest_dataset/results/**

# Online measurement tool: keep source/configuration in Git, but leave bulky
# acquisition datasets and runtime recordings on the experiment workstation.
laser_measurement_tool/data/
laser_measurement_tool/output/
laser_measurement_tool/outputs/
laser_measurement_tool/recordings/

# Device/date-specific experiment runs are local artifacts. Keep their
# provenance summaries in reports/ when a result must be reviewed in Git.
laser_measurement_tool/output_daheng_*/
